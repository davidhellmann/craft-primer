includes:
    - vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        analyse:
            # Generated by `codecept build` (the `phpstan` composer script runs it first); read for symbols only.
            - tests/Support/_generated/*
        analyseAndScan:
            - tests/_craft/storage/*
            - tests/_output/*
            - tests/browser/storage/*
            - tests/browser/web/cpresources/*
