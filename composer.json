{
    "name": "davidhellmann/craft-primer",
    "description": "Set the right defaults for your entries, if needed.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "presets",
        "defaults",
        "relation fields",
        "entries"
    ],
    "license": "proprietary",
    "authors": [
        {
            "name": "David Hellmann",
            "homepage": "https://davidhellmann.com"
        }
    ],
    "support": {
        "email": "david@hellmann.io",
        "issues": "https://github.com/davidhellmann/craft-primer/issues?state=open",
        "source": "https://github.com/davidhellmann/craft-primer",
        "docs": "https://github.com/davidhellmann/craft-primer",
        "rss": "https://github.com/davidhellmann/craft-primer/releases.atom"
    },
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.22",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "davidhellmann\\primer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "davidhellmann\\primer\\tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "primer",
        "name": "Primer",
        "developer": "David Hellmann",
        "developerUrl": "https://davidhellmann.com",
        "documentationUrl": "https://github.com/davidhellmann/craft-primer",
        "class": "davidhellmann\\primer\\Plugin"
    },
    "scripts": {
        "check-cs": "pint --test",
        "fix-cs": "pint",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
