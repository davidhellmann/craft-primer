{# The section page's content, as a page or in a slideout: the section's entry types, each with the fields its preset
   fills and its lightswitch for this site, and "+ Add preset" for the ones without, or "Only in … so far" when their presets are in other scopes
   only (the entry type's link starts this site's). Entry type icons take the type's own colour or stay neutral; field
   icons stay neutral, fields have no colour in Craft. #}
<div class="tablepane">
    <table class="data fullwidth primer-section">
        <thead>
            <tr>
                <th scope="col">{{ 'Entry Type'|t('app') }}</th>
                <th scope="col">{{ 'Fields'|t('app') }}</th>
                <th scope="col" class="thin">{{ 'Enabled'|t('app') }}</th>
                <th scope="col" class="thin"><span class="visually-hidden">{{ 'Actions'|t('app') }}</span></th>
            </tr>
        </thead>
        <tbody>
            {# A slideout request has no `?site=` of its own: the screen's params carry it. #}
            {% set siteParam = craft.app.isMultiSite ? { site: site.handle } : {} %}
            {% for row in types %}
                {% set type = row.type %}
                {% set preset = row.preset %}
                {% set typeName = type.name|t('site') %}
                {# A type with a preset opens it; one without opens a new preset. #}
                {% set screen = preset
                    ? { url: url('primer/presets/' ~ preset.id), params: { presetId: preset.id }|merge(siteParam) }
                    : { url: url('primer/presets/new', { sectionId: section.id, typeId: type.id }), params: { sectionId: section.id, typeId: type.id }|merge(siteParam) } %}
                {% set nav = { action: 'primer/presets/edit', params: screen.params }|json_encode %}
                <tr data-primer-type="{{ type.handle }}" class="{{ preset and not row.on ? 'primer-off' }}">
                    <th scope="row">
                        <a class="primer-section-type" href="{{ screen.url }}" data-primer-nav="{{ nav }}">
                            {%- if type.icon %}
                                <span class="cp-icon {{ type.color ? type.color.value : 'primer-neutral' }}">{{ iconSvg(type.icon) }}</span>
                            {% endif -%}
                            <span>{{ typeName }}</span>
                        </a>
                    </th>
                    <td>
                        {% if preset %}
                            <div class="primer-section-fields" data-primer-fields>
                                {% for element in preset.getChosenFieldElements() %}
                                    <span>
                                        <span class="cp-icon puny primer-neutral">{{ iconSvg(element.getField().icon()) }}</span>
                                        {{ element.label() ?? element.getField().name|t('site') }}
                                    </span>
                                {% else %}
                                    <span class="light">{{ 'No fields yet'|t('primer') }}</span>
                                {% endfor %}
                            </div>
                        {% elseif row.otherSites %}
                            <span class="light">{{ 'Only in {sites} so far'|t('primer', { sites: row.otherSites }) }}</span>
                        {% else %}
                            <a class="btn small dashed add icon" href="{{ screen.url }}" data-primer-nav="{{ nav }}">
                                {{- 'Add preset'|t('primer') -}}
                            </a>
                        {% endif %}
                    </td>
                    <td class="thin">
                        {% if preset %}
                            {% include 'primer/_toggle' with { preset: preset, on: row.on } only %}
                        {% endif %}
                    </td>
                    <td class="thin">
                        {% if preset %}
                            {% include 'primer/_delete' with { attributes: row.delete } only %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% include 'primer/_nav' %}

{% css %}
    .primer-section tbody th, .primer-section tbody td { vertical-align: middle; }
    .primer-section tbody th { width: 30%; }
    /* One box per cell, each centred in its row, so the link, the lightswitch and the × line up; inline, they sat
       on the text baseline, and Craft pulls a lightswitch in a table 5px into the line below. */
    .primer-section-type { display: flex; width: fit-content; align-items: center; gap: 8px; font-weight: 600; }
    .primer-section td.thin > .lightswitch, .primer-section td.thin > .delete { display: block; margin-block: 0; }
    .primer-section-fields { display: flex; flex-wrap: wrap; gap: 4px 16px; }
    .primer-section-fields > span { display: inline-flex; align-items: center; gap: 6px; }
    /* A line switched off for this site. */
    .primer-section .primer-off .primer-section-type, .primer-section .primer-off .primer-section-fields { opacity: .5; }
{% endcss %}
