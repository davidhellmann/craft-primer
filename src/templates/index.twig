{# The index: every section of the site, its entry types with a preset as Craft's entry type chips, each with its
   lightswitch for this site (dimmed when off), and "+ Add entry type" for the ones without; an entry type whose presets are in other scopes only says where.
   Every link stays in the site picked in Craft's site menu. Sections and chips open their page on click and their
   slideout on double-click (`_nav`). #}
{% extends '_layouts/cp' %}

{% set title = 'Primer'|t('primer') %}

{# Craft's site menu, as on its element indexes: the sites the user may edit. #}
{% if craft.app.isMultiSite %}
    {% set crumbs = [{
        id: 'site-crumb',
        icon: 'world',
        iconAltText: 'Site'|t('app'),
        label: site.name|t('site'),
        menu: {
            items: siteMenuItems(null, site),
            label: 'Select site'|t('app'),
        },
    }] %}
{% endif %}

{% block content %}
    <div class="tablepane">
        <table class="data fullwidth primer-index">
            <thead>
                <tr>
                    <th scope="col">{{ 'Section'|t('app') }}</th>
                    <th scope="col">{{ 'Entry types with a preset'|t('primer') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in sections %}
                    <tr data-section="{{ row.section.handle }}">
                        <th scope="row">
                            <a href="{{ url('primer/sections/' ~ row.section.handle) }}"
                               data-primer-nav="{{ { action: 'primer/presets/section', params: { sectionHandle: row.section.handle }|merge(siteParams), form: false }|json_encode }}">
                                {{- row.section.name|t('site') -}}
                            </a>
                        </th>
                        <td>
                            <div class="primer-index-cell">
                                {% if row.presets %}
                                    <ul class="primer-index-presets">
                                        {% for item in row.presets %}
                                            {% if item.preset %}
                                                <li data-preset="{{ item.preset.id }}" class="{{ item.on ? '' : 'primer-off' }}">
                                                    <a class="primer-index-chip"
                                                       href="{{ url('primer/presets/' ~ item.preset.id) }}"
                                                       data-primer-nav="{{ { action: 'primer/presets/edit', params: { presetId: item.preset.id }|merge(siteParams) }|json_encode }}">
                                                        {{ item.chipHtml|raw }}
                                                    </a>
                                                    <span class="light smalltext">
                                                        {{- '{count, plural, =1{# field} other{# fields}}'|t('primer', { count: item.fieldCount }) -}}
                                                    </span>
                                                    <span class="primer-index-actions">
                                                        {% include 'primer/_toggle' with { preset: item.preset, on: item.on } only %}
                                                        {% include 'primer/_delete' with { attributes: item.delete } only %}
                                                    </span>
                                                </li>
                                            {% else %}
                                                {# Presets in other scopes only: the chip starts this site's preset. #}
                                                <li>
                                                    <a class="primer-index-chip"
                                                       href="{{ url('primer/presets/new', { sectionId: row.section.id, typeId: item.type.id }) }}"
                                                       data-primer-nav="{{ { action: 'primer/presets/edit', params: { sectionId: row.section.id, typeId: item.type.id }|merge(siteParams) }|json_encode }}">
                                                        {{ item.chipHtml|raw }}
                                                    </a>
                                                    <span class="light smalltext">
                                                        {{- 'Only in {sites} so far'|t('primer', { sites: item.otherSites }) -}}
                                                    </span>
                                                </li>
                                            {% endif %}
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                                {% if row.available %}
                                    {{ disclosureMenu(row.available|map(type => {
                                        icon: type.icon,
                                        color: type.color,
                                        label: type.name|t('site'),
                                        url: url('primer/presets/new', { sectionId: row.section.id, typeId: type.id }),
                                    }), {
                                        buttonLabel: 'Add entry type'|t('primer'),
                                        buttonAttributes: { class: ['dashed', 'add', 'icon'] },
                                        withSearchInput: row.available|length > 5,
                                    }) }}
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'primer/_nav' %}
{% endblock %}

{% css %}
    /* One 34px line rhythm (Craft's button height), so a section's name lines up with its first chip or button. */
    .primer-index tbody th, .primer-index tbody td { vertical-align: top; }
    .primer-index tbody th { width: 30%; font-weight: 600; line-height: 34px; }
    .primer-index-cell { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
    .primer-index-presets { align-self: stretch; margin: 0; padding: 0; list-style: none; }
    .primer-index-presets li { display: flex; align-items: center; gap: var(--m); min-height: 34px; }
    .primer-index-presets li:not(:last-child) { padding-block-end: 6px; }
    .primer-index-presets li + li { border-block-start: 1px solid var(--hairline-color); padding-block-start: 6px; }
    .primer-index-chip { border-radius: var(--small-border-radius, 4px); }
    .primer-index-chip .chip { pointer-events: none; }
    .primer-index-chip:focus-visible { box-shadow: var(--focus-ring); outline: none; }
    .primer-index-actions { display: flex; align-items: center; gap: var(--m); margin-inline-start: auto; }
    /* Craft pulls a lightswitch in a table 5px into the line below; here it is centred with the chip and the ×. */
    .primer-index-actions .lightswitch { margin-block: 0; }
    /* A line switched off for this site. */
    .primer-index-presets .primer-off .primer-index-chip, .primer-index-presets .primer-off .light { opacity: .5; }
{% endcss %}
